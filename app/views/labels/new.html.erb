<h1>ラベル登録ページ</h1>

<% if @label.errors.any? %>
  <div class="alert alert-danger">
    <% @label.errors.full_messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
<% end %>

<%= form_with model: @label, local: true do |form| %>
  <div>
    <%= form.label :name, '名前' %>
    <%= form.text_field :name, class: 'form-control' %>
  </div>

  <div>
    <%= form.submit '登録する', class: 'btn btn-primary' %>
  </div>
<% end %>