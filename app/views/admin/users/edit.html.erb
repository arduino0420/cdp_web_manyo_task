<h1>ユーザ編集ページ</h1>

<% if @user.errors.any? %>
  <div>
    <% @user.errors.full_messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
<% end %>

<%= form_with model: [:admin, @user], local: true do |form| %>
  <div>
    <%= form.label :name, User.human_attribute_name(:name) %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email, User.human_attribute_name(:email) %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, User.human_attribute_name(:password) %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.label :password_confirmation, User.human_attribute_name(:password_confirmation) %>
    <%= form.password_field :password_confirmation %>
  </div>

  <div>
    <%= form.label :admin, User.human_attribute_name(:admin) %>
    <%= form.check_box :admin %>
  </div>

  <%= form.submit '更新する', id: 'update-user' %>
<% end %>

<%= link_to '戻る', admin_users_path, id: 'back' %>
