<h1><%= t('tasks.index.title') %></h1>

<%= form_with(scope: :search, url: tasks_path, method: :get, local: true) do |form| %>
  <div>
    <%= form.label :title, 'タイトル' %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :status, 'ステータス' %>
    <%= form.select :status, Task.statuses.keys, include_blank: true %>
  </div>

  <div>
    <%= form.submit '検索', id: 'search_task' %>
  </div>
<% end %>

<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:content) %></th>
      <th><%= Task.human_attribute_name(:created_at) %></th>
      <th>
        <%= link_to Task.human_attribute_name(:deadline_on),
                    tasks_path(sort_deadline_on: true) %>
      </th>
      <th>
        <%= link_to Task.human_attribute_name(:priority),
                    tasks_path(sort_priority: true) %>
      </th>
      <th><%= Task.human_attribute_name(:status) %></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.created_at %></td>
        <td><%= task.deadline_on %></td>
        <td><%= task.priority %></td>
        <td><%= task.status %></td>
        <td>
          <%= link_to t('tasks.index.show'), task_path(task), class: 'show-task' %>
          <%= link_to t('tasks.index.edit'), edit_task_path(task), class: 'edit-task' %>
          <%= link_to t('tasks.index.destroy'), task_path(task), method: :delete, data: { confirm: t('tasks.index.confirm_destroy') }, class: 'destroy-task' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @tasks %>