<h1><%= t('tasks.new.title') %></h1>

<% if @task.errors.any? %>
  <div class="alert alert-danger">
    <% @task.errors.full_messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
<% end %>

<%= form_with(model: @task, local: true) do |form| %>
  <div class="mb-3">
    <%= form.label :title, Task.human_attribute_name(:title), class: 'form-label' %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :content, Task.human_attribute_name(:content), class: 'form-label' %>
    <%= form.text_area :content, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :deadline_on, Task.human_attribute_name(:deadline_on), class: 'form-label' %>
    <%= form.date_field :deadline_on, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :priority, Task.human_attribute_name(:priority), class: 'form-label' %>
    <%= form.select :priority, Task.priorities.keys, { include_blank: true }, class: 'form-select' %>
  </div>

  <div class="mb-3">
    <%= form.label :status, Task.human_attribute_name(:status), class: 'form-label' %>
    <%= form.select :status, Task.statuses.keys, { include_blank: true }, class: 'form-select' %>
  </div>

  <div class="mb-3">
    <%= form.label :label_ids, 'ラベル', class: 'form-label' %>

    <% current_user.labels.each do |label| %>
      <div class="form-check">
        <%= form.check_box :label_ids,
                           { multiple: true, include_hidden: false, class: 'form-check-input' },
                           label.id %>
        <%= label.name %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.submit t('tasks.new.create'), id: 'create-task', class: 'btn btn-primary' %>
  </div>
<% end %>

<%= link_to t('tasks.new.back'), tasks_path, id: 'back', class: 'btn btn-secondary' %>